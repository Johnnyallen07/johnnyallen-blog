# ===== Database =====
# 本地开发：通过 SSH 隧道连接服务器数据库
# 先开隧道: ssh -i devops/johnnyallenblog.pem -N -L 15432:localhost:5432 root@<server-ip>
DATABASE_URL="postgresql://user:password@localhost:15432/blog_db?schema=public"

# ===== API =====
PORT=3001
JWT_SECRET=your_jwt_secret_here

# ===== 腾讯云 COS（对象存储） =====
COS_BUCKET=your-bucket-appid
COS_REGION=ap-hongkong
COS_SECRET_ID=your_secret_id
COS_SECRET_KEY=your_secret_key
COS_PUBLIC_DOMAIN=https://static.yourdomain.com

# ===== Gemini AI =====
# 在 https://aistudio.google.com/apikey 获取
GEMINI_API_KEY=your_gemini_api_key_here

# ===== Frontend URLs =====
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MUSIC_URL=http://localhost:3002
