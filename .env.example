# ===== Database =====
# 本地开发默认通过 npm scripts 自动开启 SSH 隧道连接服务器数据库
# 手动开启: pnpm db:tunnel
DATABASE_URL="postgresql://user:password@localhost:15432/blog_db?schema=public"

# ===== API =====
PORT=3001
JWT_SECRET=your_jwt_secret_here

# ===== 腾讯云 COS（对象存储） =====
COS_BUCKET=your-bucket-appid
COS_REGION=ap-hongkong
COS_SECRET_ID=your_secret_id
COS_SECRET_KEY=your_secret_key
COS_PUBLIC_DOMAIN=https://static.yourdomain.com

# ===== 自动翻译 (i18n) =====
# provider: openai-compatible（DeepSeek/OpenAI/Gemini 等 OpenAI 兼容端点）| anthropic
TRANSLATE_PROVIDER=openai-compatible
TRANSLATE_MODEL=gemini-2.5-flash
TRANSLATE_API_KEY=your_llm_api_key
# 可选；openai-compatible 默认 https://api.openai.com/v1，anthropic 默认 https://api.anthropic.com
TRANSLATE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ===== Frontend URLs =====
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MUSIC_URL=http://localhost:3002
