{
  "manifest_version": 3,
  "name": "Johnny Music Cookie Sync",
  "version": "1.1.0",
  "description": "在 YouTube 页面手动获取 cookies.txt，并自动填入音乐后台。",
  "permissions": ["cookies", "storage", "activeTab"],
  "host_permissions": ["https://*.youtube.com/*", "https://admin.johnnyallen.blog/*", "http://localhost:3003/*", "http://127.0.0.1:3003/*"],
  "action": { "default_title": "获取 YouTube Cookie", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://admin.johnnyallen.blog/*", "http://localhost:3003/*", "http://127.0.0.1:3003/*"],
    "js": ["content.js"],
    "all_frames": false
  }]
}
