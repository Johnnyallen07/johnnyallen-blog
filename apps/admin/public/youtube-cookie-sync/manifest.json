{
  "manifest_version": 3,
  "name": "Johnny Music Cookie Sync",
  "version": "1.0.0",
  "description": "在音乐管理页面一键同步当前浏览器的 YouTube 会话。",
  "permissions": ["cookies"],
  "host_permissions": ["https://*.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://admin.johnnyallen.blog/*", "http://localhost:3003/*", "http://127.0.0.1:3003/*"],
    "js": ["content.js"],
    "all_frames": false
  }]
}
