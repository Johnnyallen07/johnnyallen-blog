# Database
DATABASE_URL="postgresql://user@localhost:5432/blog_db?schema=public"
PORT=3001

# JWT
JWT_SECRET=your_jwt_secret_here
MOMENT_ENCRYPTION_KEY=your_independent_48_byte_secret
MOMENT_PUBLIC_API_TOKEN=your_server_to_server_public_gateway_token

# 腾讯云 COS（对象存储）- 替换原 Cloudflare R2
# 存储桶名称，格式为 BucketName-APPID，在 COS 控制台概览可查
COS_BUCKET=your-bucket-appid
# 地域，如 ap-hongkong、ap-guangzhou
COS_REGION=ap-hongkong
# 在腾讯云 访问管理 -> API 密钥管理 获取
COS_SECRET_ID=your_secret_id
COS_SECRET_KEY=your_secret_key
# 自定义源站域名（绑定到存储桶的域名），用于前端访问文件 URL
COS_PUBLIC_DOMAIN=https://static.johnnyallen.blog

# 自动翻译 (i18n)
# provider: openai-compatible（DeepSeek/OpenAI/Gemini 等 OpenAI 兼容端点）| anthropic
# TRANSLATE_API_KEY 未设置时自动回退用 GEMINI_API_KEY
TRANSLATE_PROVIDER=openai-compatible
TRANSLATE_MODEL=gemini-2.5-flash
TRANSLATE_API_KEY=your_llm_api_key
# 可选；openai-compatible 默认 https://api.openai.com/v1，anthropic 默认 https://api.anthropic.com
TRANSLATE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
