generator client {
  provider      = "prisma-client-js"
  // Docker 使用 node:20-alpine（OpenSSL 3），需明确指定否则默认 openssl-1.1 导致 libssl.so.1.1 找不到
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  username         String            @unique
  email            String?           @unique
  name             String?
  password         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  momentCredential MomentCredential?
}

// ===== Moment private library =====

enum MomentVisibility {
  PUBLIC
  PRIVATE
}

enum MomentAssetStatus {
  READY
  ARCHIVED
}

model MomentCredential {
  id                 String    @id @default(uuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totpSecretEnc      String?
  totpEnabled        Boolean   @default(false)
  recoveryCodeHashes String[]
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  lastTotpStep       BigInt?
  lastUsedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model MomentCategory {
  id          String        @id @default(uuid())
  name        String        @unique
  slug        String        @unique
  description String?
  icon        String?
  color       String?
  order       Int           @default(0)
  assets      MomentAsset[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([order])
}

model MomentAsset {
  id           String            @id @default(uuid())
  objectKey    String            @unique
  checksum     String
  originalName String
  relativePath String
  title        String?
  description  String?
  mimeType     String
  size         BigInt
  capturedAt   DateTime?
  width        Int?
  height       Int?
  tags         String[]
  visibility   MomentVisibility  @default(PRIVATE)
  featured     Boolean           @default(false)
  status       MomentAssetStatus @default(READY)
  categoryId   String?
  category     MomentCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([relativePath, checksum])
  @@index([visibility, status, capturedAt])
  @@index([categoryId, status])
  @@index([checksum])
}

model MomentSyncToken {
  id         String    @id @default(uuid())
  label      String
  tokenHash  String    @unique
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([revokedAt, expiresAt])
}

model MomentAuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  assetId   String?
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([assetId, createdAt])
}

model Post {
  id           String       @id @default(uuid())
  slug         String       @unique
  title        String
  excerpt      String? // Short preview (200-300 chars)
  content      String? // Markdown content
  thumbnailUrl String? // R2 URL for preview image
  published    Boolean      @default(false)
  featured     Boolean      @default(false)
  views        Int          @default(0)
  likes        Int          @default(0)
  category     Category     @relation(fields: [categoryId], references: [id])
  categoryId   String
  media        Media[]
  seriesItems  SeriesItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([createdAt])
  @@index([featured])
}

model Category {
  id           String  @id @default(uuid())
  slug         String  @unique
  name         String  @unique
  description  String?
  thumbnailUrl String? // R2 URL for category image
  icon         String? // Lucide icon identifier (e.g., "Gamepad2", "Music")

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  posts     Post[]
  series    Series[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([parentId])
}

model Media {
  id        String    @id @default(uuid())
  url       String
  key       String // Cloudflare R2 key
  type      MediaType
  post      Post?     @relation(fields: [postId], references: [id])
  postId    String?
  createdAt DateTime  @default(now())
}

model Series {
  id           String  @id @default(uuid())
  slug         String  @unique
  title        String
  description  String?
  thumbnailUrl String?
  emoji        String? @default("📝")
  published    Boolean @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  items SeriesItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([categoryId])
}

model SeriesItem {
  id String @id @default(uuid())

  seriesId String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  title     String? // Folder name or override post title
  published Boolean @default(false) // 控制是否对外展示

  // A SeriesItem can point to a Post, or just be a structural node (folder)
  postId String?
  post   Post?   @relation(fields: [postId], references: [id])

  // Tree structure
  parentId String?
  parent   SeriesItem?  @relation("SeriesTree", fields: [parentId], references: [id])
  children SeriesItem[] @relation("SeriesTree")

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seriesId])
  @@index([parentId])
}

model MusicTrack {
  id        String   @id @default(uuid())
  title     String
  musician  String
  performer String
  category  String
  series    String?
  duration  Int      @default(0)
  fileKey   String
  fileUrl   String
  fileSize  Int      @default(0)
  coverUrl  String?
  order     Int      @default(0)
  playCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([musician])
  @@index([category])
  @@index([order])
}

model MusicCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model MusicArtist {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model MusicSeries {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model MusicScore {
  id         String   @id @default(uuid())
  title      String
  composer   String?
  instrument String
  // "pdf"：fileKey/fileUrl 指向单个 PDF；"images"：pages 按顺序存每页图片，fileKey/fileUrl 指向第一页
  fileType   String   @default("pdf")
  // 图片乐谱页面（按展示顺序）：[{ key, url, size? }]
  pages      Json?
  fileKey    String
  fileUrl    String
  fileSize   Int      @default(0)
  pageCount  Int      @default(0)
  coverUrl   String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([instrument])
  @@index([order])
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  FILE
}

// ===== i18n =====

enum TranslationStatus {
  MACHINE // 机器翻译，未经人工校对
  REVIEWED // 人工校对/编辑过
}

// 前端 UI 文案（key 与中文源文案以 apps/{web,music}/messages/zh.json 为准，由 i18n-sync 脚本同步进来）
model UiMessage {
  id           String                 @id @default(uuid())
  app          String // 'web' | 'music'
  namespace    String // 'home' | 'nav' | 'player' ...
  key          String // namespace 内的点路径，如 'pagination.prev'
  sourceText   String // 中文原文（zh.json 镜像）
  description  String? // 给译者/LLM 的补充上下文
  locations    String[] // 使用位置，如 'app/[locale]/home-client.tsx:374'
  orphaned     Boolean                @default(false) // key 已从代码中移除
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  translations UiMessageTranslation[]

  @@unique([app, namespace, key])
  @@index([app, orphaned])
}

model UiMessageTranslation {
  id         String            @id @default(uuid())
  message    UiMessage         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId  String
  locale     String // 'en'
  text       String
  status     TranslationStatus @default(MACHINE)
  sourceHash String? // 翻译时 sourceText 的 sha256，用于过期检测
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([messageId, locale])
  @@index([locale, status])
}

// 数据库动态内容的翻译，按 (实体类型, 实体ID, 字段, 语言) 覆盖中文源字段
model ContentTranslation {
  id         String            @id @default(uuid())
  entityType String // 'post'|'category'|'series'|'seriesItem'|'musicTrack'|'musicCategory'|'musicArtist'|'musicSeries'|'musicScore'
  entityId   String
  field      String // 'title'|'excerpt'|'content'|'name'|'description'|'musician'|'performer'|'composer'
  locale     String // 'en'
  value      String
  status     TranslationStatus @default(MACHINE)
  sourceHash String // 翻译时中文源值的 sha256，用于过期检测
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([entityType, entityId, field, locale])
  @@index([entityType, locale])
  @@index([locale, status])
}
